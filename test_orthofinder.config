// Supply -c test_orthofinder.config after the normal project config.
// Edit test_output in the parameters YAML.
process {
    withName: 'ORTHOFINDER_RAW_FASTAS' {
        publishDir = [path: "${params.test_output}/fastas", mode: 'copy', overwrite: true]
    }
    withName: 'ORTHOFINDER_IQTREE_NT' {
        publishDir = [path: "${params.test_output}/trees_nt", mode: 'copy', overwrite: true]
    }
    withName: 'ORTHOFINDER_IQTREE_AA' {
        publishDir = [path: "${params.test_output}/trees_aa", mode: 'copy', overwrite: true]
    }
}
